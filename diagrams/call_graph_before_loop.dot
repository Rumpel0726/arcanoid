// Граф вызовов игровой логики арканоида: исходное состояние (тег seminar-1) - часть «Игровой цикл»
// Сгенерировано из описания графа; цвет - категория кода, * и пунктир - спорное положение
digraph before_loop {
    rankdir=TB; newrank=true; ranksep=0.35; nodesep=0.2;
    node [shape=plain, fontname="Consolas", fontsize=10];
    edge [color="#7a8494", arrowsize=0.45, penwidth=0.8];

    // подписи слоёв
    L7 [shape=plaintext, fontname="Segoe UI", fontsize=10, fontcolor="#1f4e8c", label="7. Игровой цикл"];
    L6 [shape=plaintext, fontname="Segoe UI", fontsize=10, fontcolor="#1f4e8c", label="6. Действия объектов за кадр"];
    L5 [shape=plaintext, fontname="Segoe UI", fontsize=10, fontcolor="#1f4e8c", label="5. Правила игры"];
    L2 [shape=plaintext, fontname="Segoe UI", fontsize=10, fontcolor="#1f4e8c", label="2. Структуры данных (классы)"];
    L0 [shape=plaintext, fontname="Segoe UI", fontsize=10, fontcolor="#1f4e8c", label="0. Python, pygame, настройки"];
    L7 -> L6 -> L5 -> L2 -> L0 [style=invis];

    // слой 7: Игровой цикл
    game7_0 [shape=box, style="rounded,filled", fillcolor="#fbe3d6", color="#c0582b", label="Game()"];
    game7_1 [shape=box, style="rounded,filled", fillcolor="#fbe3d6", color="#c0582b", label="Game.start"];
    { rank=same; L7; game7_0; game7_1; }

    // слой 6: Действия объектов за кадр
    game6_0 [shape=box, style="rounded,filled", fillcolor="#fbe3d6", color="#c0582b", label="Game.set_game"];
    bonus6_0 [shape=box, style="rounded,filled", fillcolor="#fbe3d6", color="#c0582b", label="Bonus.move"];
    bonus6_1 [shape=box, style="rounded,filled", fillcolor="#fbe3d6", color="#c0582b", label="Bonus.draw"];
    level6_0 [shape=box, style="rounded,filled", fillcolor="#fbe3d6", color="#c0582b", label="Level.draw"];
    { rank=same; L6; game6_0; bonus6_0; bonus6_1; level6_0; }

    // слой 5: Правила игры
    bonuspy5_1 [shape=box, style="rounded,filled", fillcolor="#e3f1e6", color="#2e7d4f", label="apply_bonus"];
    bonuspy5_2 [shape=box, style="rounded,filled", fillcolor="#e3f1e6", color="#2e7d4f", label="is_bonus_caught"];
    { rank=same; L5; bonuspy5_1; bonuspy5_2; }

    // слой 2: Структуры данных (классы)
    brick2_0 [shape=box, style="rounded,filled", fillcolor="#e2ebf7", color="#2f5d9a", label="Brick()"];
    brick2_8 [shape=box, style="rounded,filled,dashed", fillcolor="#fbe3d6", color="#c0582b", label="Brick.draw *"];
    racket2_2 [shape=box, style="rounded,filled,dashed", fillcolor="#e2ebf7", color="#2f5d9a", label="Racket.get_rect *"];
    level2_0 [shape=box, style="rounded,filled", fillcolor="#e2ebf7", color="#2f5d9a", label="Level()"];
    { rank=same; L2; brick2_0; brick2_8; racket2_2; level2_0; }

    // слой 0: Python, pygame, настройки
    py0_0 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#8a8a8a", label="for"];
    py0_1 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#8a8a8a", label="len()"];
    py0_2 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#8a8a8a", label="[i]"];
    py0_3 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#8a8a8a", label=".поле"];
    pg0_1 [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#8a8a8a", label="colliderect()"];
    { rank=same; L0; py0_0; py0_1; py0_2; py0_3; pg0_1; }

    // вызовы
    game7_0 -> { level2_0; brick2_0; }  // Game()
    game7_1 -> { level6_0; py0_0; py0_1; py0_2; bonus6_1; bonus6_0; bonuspy5_2; racket2_2; py0_3; bonuspy5_1; }  // Game.start
    game6_0 -> { level2_0; brick2_0; }  // Game.set_game
    level6_0 -> { py0_0; py0_1; py0_2; brick2_8; }  // Level.draw
    bonuspy5_2 -> { py0_3; pg0_1; }  // is_bonus_caught
}
